# ==============================================================================
# SMART NOTES ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and customize for your deployment environment. Never commit .env!
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_BASE_URL=http://localhost:8000

# MongoDB Atlas Persistent Database
# Provide your MongoDB Atlas connection string (e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority)
# If left blank, the app will gracefully initialize an in-memory MongoMock database for local evaluation.
MONGODB_URI=
DATABASE_NAME=smart_notes_db

# Security & Authentication
JWT_SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Machine Learning & Uncertainty Thresholds
UNCERTAINTY_THRESHOLD=0.50
MIN_SEARCH_SIMILARITY=0.05

# SMTP Email Configuration (Optional - Dev fallback logs links in terminal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@smartnotes.ai

